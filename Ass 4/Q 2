#include <iostream>
using namespace std;


bool isSorted(int arr[], int n) {

    for (int i = 1; i < n; i++) {

        if (arr[i] < arr[i - 1]) {
            return false; 
        }
    }

    return true;
}

int main() {
    int n;
    cout << "How many numbers? ";
    cin >> n;

    int arr[n]; 
    cout << "Enter " << n << " numbers: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    if (isSorted(arr, n)) {
        cout << "Result: Sorted!" << endl;
    } else {
        cout << "Result: Not Sorted!" << endl;
    }

    return 0;
}
