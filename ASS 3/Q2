
#include <iostream>
using namespace std;

// Function to add up all digits of a number
int sumOfDigits(int n) {
    // 1. Base Case: If the number is 0, the sum is 0
    if (n == 0) {
        return 0;
    }

    // 2. Recursive Step: 
    // (n % 10) gets the last digit
    // sumOfDigits(n / 10) removes the last digit and processes the rest
    return (n % 10) + sumOfDigits(n / 10);
}

int main() {
    int N;
    cout << "Enter a number: ";
    cin >> N;

    // Optional: Handle negative numbers by converting to positive
    if (N < 0) N = -N;

    cout << "Sum of digits: " << sumOfDigits(N) << endl;

    return 0;
}
