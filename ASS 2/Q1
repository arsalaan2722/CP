#include <iostream>
using namespace std;

int main() {
    int N, n;

    cout << "Enter number (N): ";
    cin >> N;

    cout << "Enter bit position (n): ";
    cin >> n;

    int mask = 1 << n;

    if (N & mask)
        cout << "Bit at position " << n << " is SET (1)" << endl;
    else
        cout << "Bit at position " << n << " is CLEAR (0)" << endl;

    return 0;
}
