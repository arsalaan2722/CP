#include <iostream>
using namespace std;

// Recursive function to calculate n raised to the power m
int power(int n, int m) {
    // Base case: any number to the power of 0 is 1
    if (m == 0) 
        return 1;
    
    // Recursive step: n^m = n * n^(m-1)
    return n * power(n, m - 1);
}

int main() {
    int N, m;

    cout << "Enter base (N): ";
    cin >> N;
    cout << "Enter power (m): ";
    cin >> m;

    cout << "Result: " << power(N, m) << endl;

    return 0;
}
